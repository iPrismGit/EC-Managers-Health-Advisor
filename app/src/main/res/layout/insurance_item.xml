<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:strokeColor="@color/light_gray1"
    app:strokeWidth="0.5dp"
    android:layout_margin="8dp">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">


        <ImageView
            android:id="@+id/facility_img"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/insurance_logo" />

        <ImageView
            android:id="@+id/play_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/play_btn"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/facility_img"
            app:layout_constraintEnd_toEndOf="@+id/facility_img"
            app:layout_constraintStart_toStartOf="@+id/facility_img"
            app:layout_constraintTop_toTopOf="@+id/facility_img" />

        <ImageView
            android:id="@+id/plus_img"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="16dp"
            android:visibility="gone"
            android:src="@drawable/plus_img"
            app:layout_constraintBottom_toBottomOf="@+id/facility_img"
            app:layout_constraintEnd_toEndOf="@+id/facility_img" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>